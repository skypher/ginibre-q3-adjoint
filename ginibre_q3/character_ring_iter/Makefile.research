# SU(2) central-character research targets.
#
# These programs belong to the open central-character / GKS2* investigation
# recorded in CENTRAL_CHARACTER_Q3_SEARCH.md and the dated SU2_* notes.  They
# are diagnostics, probes, and frontier verifiers.  None of them is an
# incoming node of the published Parts I--III theorem.
#
# They live here, and not in `Makefile`, on purpose.  `Makefile` is a
# manifested publication source: its bytes are bound by
#   certificates/full_q3/full_q3_source_manifest.sha256
#   replay_sources.sha256
#   certificates/post_m29/bc_interval_tail_code.sha256
# and `make -C ginibre_q3 publication-preflight` fails closed when they
# change.  Appending research targets to that file silently invalidates the
# publication source binding, which is exactly what happened between
# 2026-07-22 and 2026-07-25.
#
# Add new research targets HERE.  Build with:
#   make -f Makefile.research <target>

CXX ?= g++

verify_su2_plucker_second_syzygies: verify_su2_plucker_second_syzygies.cpp
	$(CXX) -O2 -std=c++20 -Wall -Wextra -Wpedantic -Wconversion \
		-Wshadow -Werror -fopenmp $< -o $@

